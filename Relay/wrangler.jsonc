{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaname-phase3-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaname-phase3-relay",
      "database_id": "361a9393-37b6-4a5f-8b61-b416471c1538",
      "migrations_dir": "migrations"
    }
  ]
}
