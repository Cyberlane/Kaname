{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kaname.dev/workflow/v1/registry.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "registryVersion",
    "draft",
    "baseURI",
    "rootSchemas",
    "executionStatus",
    "nodeTypes"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.kaname.dev/workflow/v1/registry.schema.json"
    },
    "registryVersion": {
      "const": 1
    },
    "draft": {
      "const": "2020-12"
    },
    "baseURI": {
      "const": "https://schemas.kaname.dev/workflow/v1/"
    },
    "rootSchemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]+\\.schema\\.json$"
      },
      "uniqueItems": true
    },
    "executionStatus": {
      "const": "schema-only"
    },
    "nodeTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "typeVersion",
          "executable"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "typeVersion": {
            "const": 1
          },
          "executable": {
            "const": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
