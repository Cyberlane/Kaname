{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kaname.dev/workflow/v1/mapping.schema.json",
  "$defs": {
    "literal": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "null"
            },
            "value": {
              "type": "null"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "json"
            },
            "value": true
          },
          "additionalProperties": false
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "whole"
          ],
          "properties": {
            "whole": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "select"
          ],
          "properties": {
            "select": {
              "$ref": "value-reference.schema.json"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "$ref": "#/$defs/literal"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "object"
          ],
          "properties": {
            "object": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/expression"
              },
              "maxProperties": 128
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "array"
          ],
          "properties": {
            "array": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "maxItems": 128
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "coalesce"
          ],
          "properties": {
            "coalesce": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 2,
              "maxItems": 16
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "format"
          ],
          "properties": {
            "format": {
              "type": "object",
              "required": [
                "template",
                "values"
              ],
              "properties": {
                "template": {
                  "type": "string",
                  "maxLength": 8192
                },
                "values": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/expression"
                  },
                  "maxProperties": 64
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$ref": "#/$defs/expression"
}
