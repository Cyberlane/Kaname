{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kaname.dev/workflow/v1/error-envelope.schema.json",
  "type": "object",
  "required": [
    "code",
    "category",
    "message",
    "retryability",
    "outcome",
    "details"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "category": {
      "enum": [
        "validation",
        "configuration",
        "execution",
        "timeout",
        "authority",
        "connector",
        "storage",
        "cancelled"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "retryability": {
      "enum": [
        "never",
        "safe",
        "reconcile-first"
      ]
    },
    "outcome": {
      "enum": [
        "known-failure",
        "unknown"
      ]
    },
    "details": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true
    },
    "cause": {
      "$ref": "#"
    }
  },
  "additionalProperties": false
}
