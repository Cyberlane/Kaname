{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kaname.dev/workflow/v1/compiled.schema.json",
  "$defs": {
    "digest": {
      "$ref": "identifiers.schema.json#/$defs/sha256"
    },
    "compiledNode": {
      "type": "object",
      "required": [
        "id",
        "key",
        "name",
        "type",
        "typeVersion",
        "executionAvailability",
        "config",
        "ports"
      ],
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/uuidV7"
        },
        "key": {
          "$ref": "identifiers.schema.json#/$defs/key"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "typeVersion": {
          "type": "integer",
          "minimum": 1
        },
        "executionAvailability": {
          "enum": [
            "schema-only",
            "executable"
          ]
        },
        "config": {
          "type": "object"
        },
        "ports": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "port.schema.json"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "compiledFormatVersion",
    "workflowId",
    "packageId",
    "definitionDigest",
    "layoutDigest",
    "schemaBundleDigest",
    "dependencyLockDigest",
    "configurationContractDigest",
    "entrypoints",
    "interfaces",
    "nodes",
    "edges",
    "resources",
    "policies",
    "storage",
    "dependencies"
  ],
  "properties": {
    "compiledFormatVersion": {
      "const": 1
    },
    "workflowId": {
      "$ref": "identifiers.schema.json#/$defs/uuidV7"
    },
    "packageId": {
      "$ref": "identifiers.schema.json#/$defs/packageId"
    },
    "definitionDigest": {
      "$ref": "#/$defs/digest"
    },
    "layoutDigest": {
      "$ref": "#/$defs/digest"
    },
    "schemaBundleDigest": {
      "$ref": "#/$defs/digest"
    },
    "dependencyLockDigest": {
      "$ref": "#/$defs/digest"
    },
    "configurationContractDigest": {
      "$ref": "#/$defs/digest"
    },
    "entrypoints": {
      "$ref": "graph.schema.json#/$defs/entrypoints"
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "port.schema.json"
        },
        "maxItems": 128
      },
      "maxProperties": 64
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/compiledNode"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "$ref": "edge.schema.json"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "identifiers.schema.json#/$defs/schemaRef"
      },
      "maxProperties": 1024
    },
    "policies": {
      "type": "object",
      "additionalProperties": {
        "$ref": "policy.schema.json"
      },
      "maxProperties": 256
    },
    "storage": {
      "type": "object",
      "additionalProperties": {
        "$ref": "storage-declaration.schema.json"
      },
      "maxProperties": 256
    },
    "dependencies": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "dependency-lock.schema.json#/$defs/dependency"
      }
    }
  },
  "additionalProperties": false
}
