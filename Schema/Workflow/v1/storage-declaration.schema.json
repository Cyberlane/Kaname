{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kaname.dev/workflow/v1/storage-declaration.schema.json",
  "type": "object",
  "required": [
    "key",
    "scope",
    "kind",
    "schemaRef",
    "maximumBytes",
    "classification"
  ],
  "properties": {
    "key": {
      "$ref": "identifiers.schema.json#/$defs/key"
    },
    "scope": {
      "enum": [
        "job",
        "case",
        "workflow"
      ]
    },
    "kind": {
      "enum": [
        "value",
        "file",
        "directory"
      ]
    },
    "schemaRef": {
      "$ref": "identifiers.schema.json#/$defs/schemaRef"
    },
    "maximumBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10737418240
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ]
    },
    "conflictPolicy": {
      "enum": [
        "fail",
        "compare-and-swap",
        "replace"
      ]
    }
  },
  "additionalProperties": false
}
