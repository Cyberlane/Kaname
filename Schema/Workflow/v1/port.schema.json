{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kaname.dev/workflow/v1/port.schema.json",
  "type": "object",
  "required": [
    "id",
    "key",
    "label",
    "direction",
    "cardinality",
    "schemaRef",
    "required"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "key": {
      "$ref": "identifiers.schema.json#/$defs/key"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "direction": {
      "enum": [
        "input",
        "output"
      ]
    },
    "cardinality": {
      "enum": [
        "one",
        "many"
      ]
    },
    "schemaRef": {
      "$ref": "identifiers.schema.json#/$defs/schemaRef"
    },
    "required": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
