{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kaname.dev/workflow/v1/node-envelope.schema.json",
  "type": "object",
  "required": [
    "id",
    "key",
    "name",
    "type",
    "typeVersion",
    "config"
  ],
  "properties": {
    "id": {
      "$ref": "identifiers.schema.json#/$defs/uuidV7"
    },
    "key": {
      "$ref": "identifiers.schema.json#/$defs/key"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "typeVersion": {
      "type": "integer",
      "minimum": 1
    },
    "config": {
      "type": "object"
    },
    "policyRefs": {
      "type": "object",
      "properties": {
        "retry": {
          "$ref": "identifiers.schema.json#/$defs/key"
        },
        "timeout": {
          "$ref": "identifiers.schema.json#/$defs/key"
        },
        "concurrency": {
          "$ref": "identifiers.schema.json#/$defs/key"
        },
        "authority": {
          "$ref": "identifiers.schema.json#/$defs/key"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true
    }
  }
}
