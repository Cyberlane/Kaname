#!/bin/sh

set -eu

input=""
output=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --input) input="$2"; shift 2 ;;
        --output) output="$2"; shift 2 ;;
        *) exit 64 ;;
    esac
done

[ -n "$input" ]
[ -n "$output" ]
[ -s "$input" ]
printf '%s' '{"passed":true,"summary":"Synthetic document contract passed."}' > "$output"
