{
  "manifestVersion": 1,
  "privacyClass": "synthetic-public",
  "baseArguments": ["--desktop-destination", "automations", "--desktop-automation-workflows-prototype"],
  "captures": [
    {"name": "portfolio-wide", "width": 1520, "height": 940, "arguments": [], "routes": ["portfolio.versions"]},
    {"name": "portfolio-compact", "width": 1080, "height": 700, "arguments": [], "routes": ["portfolio.versions"]},
    {"name": "builder-canvas", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder"], "routes": ["builder.canvas"]},
    {"name": "builder-editing", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-editing"], "routes": ["builder.canvas"]},
    {"name": "builder-versions", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-versions"], "routes": ["portfolio.versions", "runs.revision-diagram"]},
    {"name": "builder-new", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-new"], "routes": ["builder.canvas"]},
    {"name": "builder-condition", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-condition"], "routes": ["builder.match"]},
    {"name": "builder-mapping", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-mapping"], "routes": ["builder.mapping"]},
    {"name": "builder-test", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-test"], "routes": ["builder.canvas"]},
    {"name": "builder-problems", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-problems"], "routes": ["builder.problems", "builder.source", "builder.authority"]},
    {"name": "builder-problems-compact", "width": 1080, "height": 700, "arguments": ["--desktop-automation-builder-problems"], "routes": ["builder.problems"]},
    {"name": "builder-problems-collapsed", "width": 1080, "height": 700, "arguments": ["--desktop-automation-builder-problems", "--desktop-automation-builder-problems-collapsed"], "routes": ["builder.problems"]},
    {"name": "builder-problems-source", "width": 1080, "height": 700, "arguments": ["--desktop-automation-builder-problems", "--desktop-automation-builder-problems-source"], "routes": ["builder.problems", "builder.source"]},
    {"name": "builder-publish", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-publish"], "routes": ["portfolio.versions"]},
    {"name": "builder-storage", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-storage"], "routes": ["builder.storage"]},
    {"name": "builder-storage-promotion", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-storage-promotion"], "routes": ["builder.storage"]},
    {"name": "builder-outline", "width": 1520, "height": 940, "arguments": ["--desktop-automation-outline"], "routes": ["builder.canvas"]},
    {"name": "match-named-ports", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-match"], "routes": ["builder.match"]},
    {"name": "match-expanded-board", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-match-board"], "routes": ["builder.match"]},
    {"name": "match-object", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-match-object"], "routes": ["builder.match-object", "builder.match-compound"]},
    {"name": "match-error-retry", "width": 1520, "height": 940, "arguments": ["--desktop-automation-builder-match-error"], "routes": ["builder.retry"]},
    {"name": "canvas-parallel", "width": 1520, "height": 940, "arguments": ["--desktop-automation-canvas-parallel"], "routes": ["builder.parallel"]},
    {"name": "canvas-approval", "width": 1520, "height": 940, "arguments": ["--desktop-automation-canvas-approval"], "routes": ["builder.authority"]},
    {"name": "canvas-feedback", "width": 1520, "height": 940, "arguments": ["--desktop-automation-canvas-feedback"], "routes": ["builder.feedback-loop", "builder.wait-loop"]},
    {"name": "canvas-recovery", "width": 1520, "height": 940, "arguments": ["--desktop-automation-canvas-recovery"], "routes": ["builder.retry"]},
    {"name": "canvas-small-readable", "width": 1080, "height": 700, "arguments": ["--desktop-automation-small-readable"], "routes": ["builder.canvas"]},
    {"name": "canvas-small-overview", "width": 1080, "height": 700, "arguments": ["--desktop-automation-small-overview"], "routes": ["builder.canvas"]},
    {"name": "canvas-small-focus", "width": 1080, "height": 700, "arguments": ["--desktop-automation-small-focus"], "routes": ["builder.canvas"]},
    {"name": "runs-history", "width": 1520, "height": 940, "arguments": ["--desktop-automation-design-runs"], "routes": ["runs.history", "runs.retention", "runs.running", "runs.waiting", "runs.resumed", "runs.case-history", "runs.revision-diagram"]},
    {"name": "run-step-input", "width": 1520, "height": 940, "arguments": ["--desktop-automation-design-runs", "--desktop-automation-run-step-detail"], "routes": ["runs.node-inspector"]},
    {"name": "run-step-error", "width": 1520, "height": 940, "arguments": ["--desktop-automation-design-runs", "--desktop-automation-run-step-error"], "routes": ["runs.error", "runs.unknown-outcome"]},
    {"name": "run-match-edge", "width": 1520, "height": 940, "arguments": ["--desktop-automation-design-runs", "--desktop-automation-run-edge"], "routes": ["runs.match-trace"]},
    {"name": "run-llm-context", "width": 1520, "height": 940, "arguments": ["--desktop-automation-design-runs", "--desktop-automation-run-llm-context"], "routes": ["runs.llm-context"]},
    {"name": "run-llm-messages", "width": 1520, "height": 940, "arguments": ["--desktop-automation-design-runs", "--desktop-automation-run-llm-messages"], "routes": ["runs.llm-messages"]},
    {"name": "run-llm-tools", "width": 1520, "height": 940, "arguments": ["--desktop-automation-design-runs", "--desktop-automation-run-llm-tools"], "routes": ["runs.llm-tools"]},
    {"name": "run-storage", "width": 1520, "height": 940, "arguments": ["--desktop-automation-design-runs", "--desktop-automation-run-storage"], "routes": ["runs.storage-inspector"]},
    {"name": "run-storage-delete", "width": 1520, "height": 940, "arguments": ["--desktop-automation-design-runs", "--desktop-automation-run-storage-delete"], "routes": ["runs.delete-preview", "runs.purged"]},
    {"name": "runs-compact", "width": 1080, "height": 700, "arguments": ["--desktop-automation-design-runs", "--desktop-automation-run-llm-tools"], "routes": ["runs.history", "runs.llm-tools"]}
  ]
}
